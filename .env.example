# Copy to .env for local dev. In production these are Cloudflare Worker secrets
# (`wrangler secret put NAME`) — see DEPLOY.md.

# ── Required ─────────────────────────────────────────────────────────────
# Supabase: use the SESSION POOLER string (host aws-*.pooler.supabase.com,
# port 5432). NOT the transaction pooler (6543).
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SESSION_SECRET=generate-a-long-random-string
# Public URL the app is served from (OAuth callbacks, storefront + delivery links)
BASE_URL=https://eatout.yourdomain.com
PORT=8080

# ── Object storage (Cloudflare R2) — required for image uploads ───────────
PRIVATE_OBJECT_DIR=private
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Payments (Stripe) — card checkout, subscriptions, Connect payouts ────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# ── Optional integrations (app runs without them, features degrade) ──────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_SERVER=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
LOG_LEVEL=info

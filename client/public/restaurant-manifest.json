{
  "name": "EatOut Restaurant Manager",
  "short_name": "EatOut Manager",
  "description": "Manage your restaurant orders, menu, and operations in real-time",
  "start_url": "/dashboard",
  "display": "standalone",
  "background_color": "#02090a",
  "theme_color": "#061a1c",
  "orientation": "any",
  "scope": "/",
  "icons": [
    {
      "src": "/icons/restaurant-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/restaurant-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/restaurant-icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/restaurant-orders.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Order Management - Accept and manage orders in real-time"
    },
    {
      "src": "/screenshots/restaurant-menu.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Menu Management - Update your menu items and pricing"
    },
    {
      "src": "/screenshots/restaurant-dashboard.png",
      "sizes": "2560x1440",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Analytics Dashboard - Track sales and performance"
    }
  ],
  "categories": ["food", "business", "productivity"],
  "shortcuts": [
    {
      "name": "Orders",
      "short_name": "Orders",
      "description": "View and manage current orders",
      "url": "/orders",
      "icons": [{ "src": "/icons/restaurant-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Menu",
      "short_name": "Menu",
      "description": "Edit your menu items",
      "url": "/menu",
      "icons": [{ "src": "/icons/restaurant-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Analytics",
      "short_name": "Analytics",
      "description": "View sales and reports",
      "url": "/dashboard",
      "icons": [{ "src": "/icons/restaurant-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "description": "Restaurant settings",
      "url": "/settings",
      "icons": [{ "src": "/icons/restaurant-icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "display_override": ["standalone", "fullscreen"],
  "protocol_handlers": [
    {
      "protocol": "web+eatout",
      "url": "/orders?id=%s"
    }
  ]
}
